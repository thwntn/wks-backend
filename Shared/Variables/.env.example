QueuePublisherTimeoutSeconds="30"
QueuePublisherMaxRetryDelaySeconds="30"
WithConsumer="true"
WithJob="false"
PrefixJob="/jobs"
HangfirePrefix="wks:jobs:"
WithSocket="true"
SocketChannel="wks:socket"
